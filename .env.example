SECRET_KEY=change-me
PYTHON_VERSION=3.12.13
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://society_user:your_password@localhost:5432/society_maintenance
OVERDUE_DAYS=3
MAX_UPLOAD_SIZE=2097152
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional Cloudinary uploads
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Optional SMTP. Defaults to console email backend locally.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Society Tracker <your-email@gmail.com>
